# --- Python ---
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
.pytest_cache/

# --- Virtualenv ---
.venv/
venv/
env/

# --- macOS ---
.DS_Store

# --- Docker ---
*.log

# --- Editors ---
.vscode/
.idea/

# --- AWS deployment config / secrets (account-specific, not for git) ---
deploy/aws/config.env
deploy/aws/.env

# --- Cyberroom build output ---
# Cyberroom/content/media/ is a generated copy of the photo files and dist/ holds the zip /
# single-file builds -- both come from tools/build_static_site.py, so neither belongs in git.
# Cyberroom/content/content.js (small, text) is kept so the folder opens as-is.
Cyberroom/content/media/
dist/

# --- Game content media (images) ---
# Photo pairs live under content-source/ and are copied (and shrunk) into Cyberroom/ by
# the build, so the big originals stay out of git. notes.json, the email JSON and the SVG
# pictures are plain text and ARE kept.
content-source/**/*.jpg
content-source/**/*.jpeg
content-source/**/*.png
content-source/**/*.webp

# --- Archive: the retired Flask / native / AWS version ---
archive/.venv/
# AWS deployment config / secrets (account-specific, not for git)
archive/deploy/aws/config.env
archive/deploy/aws/.env
archive/app/static/content/**/*.mp3
archive/app/static/content/**/*.wav
archive/app/static/content/**/*.mp4
archive/app/static/content/**/*.webm
archive/app/static/content/**/*.mov
archive/app/static/content/**/*.jpg
archive/app/static/content/**/*.jpeg
archive/app/static/content/**/*.png
archive/app/static/content/**/*.webp
archive/site.zip
