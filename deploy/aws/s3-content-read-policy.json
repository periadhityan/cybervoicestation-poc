{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListContentPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {
        "StringLike": { "s3:prefix": "content/*" }
      }
    },
    {
      "Sid": "ReadContentObjectsOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/content/*"
    }
  ]
}
